SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:2987/buenows-main
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password

JWT_SECRET=replace_with_at_least_32_random_characters
HASH_SALT=replace_with_random_hash_salt
EMAIL_PWD=replace_with_gmail_app_password

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
APP_JWT_ISSUER=https://bueno-ws.ch
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_FRONTEND_CONTACT_URL=http://localhost:5173/contact
APP_SECURITY_REQUIRE_HTTPS=false
APP_COOKIE_SECURE=false
APP_TRUSTED_PROXY_CIDRS=loopback,private
SERVER_FORWARD_HEADERS_STRATEGY=none
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

OPENAI_API_KEY=replace_with_openai_server_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_GUARD_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=500
MAX_GUARD_OUTPUT_TOKENS=320

RATE_LIMITS=active
CHATBOT_HEALTH_DETAILS=false
CHATBOT_HISTORY_RETENTION_DAYS=7
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=60
SESSION_RATE_LIMIT_PER_MINUTE=10
SESSION_RATE_LIMIT_PER_DAY=10
SESSION_MESSAGE_LIMIT=60
SESSION_TTL_MINUTES=360

